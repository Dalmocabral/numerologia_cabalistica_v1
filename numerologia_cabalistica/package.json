{
  "homepage": "https://dalmocabral.github.io/numerologia_cabalistica_v1",
  "name": "numerologia_cabalistica",
  "private": true,
  "version": "1.0.14",
  "author": "Dalmo Cabral",
  "description": "Numerologia Cabalística Desktop App",
  "build": {
    "appId": "com.numeris.app",
    "productName": "Numeris",
    "copyright": "Copyright © 2025 Dalmo Cabral",
    "publish": [
      {
        "provider": "github",
        "owner": "DalmoCabral",
        "repo": "numerologia_cabalistica_v1"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev:electron": "cross-env ELECTRON_BUILD=true vite",
    "build:electron": "npx cross-env ELECTRON_BUILD=true vite build && electron-builder",
    "build:electron:publish": "npx cross-env ELECTRON_BUILD=true vite build && electron-builder -p always"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "firebase": "^12.7.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.15"
  }
}
